[Unit]
Description=Matalabs 4-Skill English Test Go Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/matalabs/backend
ExecStart=/home/ubuntu/matalabs/backend/server
Restart=always
RestartSec=5
EnvironmentFile=/home/ubuntu/matalabs/backend/.env

[Install]
WantedBy=multi-user.target
